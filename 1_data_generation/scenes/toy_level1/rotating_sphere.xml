<?xml version="1.0" encoding="utf-8"?>
<!--
TPE Level 1 Validation Scene B: Rotating Light Around Sphere
Purpose: Test TPE on curved surfaces with rotating illumination
Expected: Lighting gradient rotates smoothly with sun position
-->
<scene version="3.0.0">
    <!-- Path tracer integrator -->
    <integrator type="path">
        <integer name="max_depth" value="8"/>
    </integrator>

    <!-- Central sphere: 1m radius diffuse -->
    <shape type="sphere" id="center_sphere">
        <transform name="to_world">
            <scale value="1.0"/>
            <translate value="0, 0, 0"/>
        </transform>
        <bsdf type="diffuse">
            <rgb name="reflectance" value="0.7, 0.5, 0.3"/>
        </bsdf>
    </shape>

    <!-- Ground plane for bounce lighting -->
    <shape type="rectangle" id="ground">
        <transform name="to_world">
            <translate value="0, 0, -1"/>
            <scale value="5, 5, 1"/>
        </transform>
        <bsdf type="diffuse">
            <rgb name="reflectance" value="0.6, 0.6, 0.6"/>
        </bsdf>
    </shape>

    <!-- Directional sun light (will be modified dynamically) -->
    <emitter type="directional" id="sun">
        <vector name="direction" value="0, 0.866, -0.5"/>
        <rgb name="irradiance" value="2.0, 1.9, 1.7"/>
    </emitter>

    <!-- Ambient environment light -->
    <emitter type="constant">
        <rgb name="radiance" value="0.15, 0.18, 0.22"/>
    </emitter>

    <!-- Default camera (for visualization) -->
    <sensor type="perspective" id="camera">
        <float name="fov" value="45"/>
        <transform name="to_world">
            <lookat origin="4, 4, 2" target="0, 0, 0" up="0, 0, 1"/>
        </transform>
        <film type="hdrfilm">
            <integer name="width" value="512"/>
            <integer name="height" value="512"/>
        </film>
    </sensor>
</scene>
